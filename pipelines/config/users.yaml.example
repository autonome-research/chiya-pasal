# pipelines/config/users.yaml
#
# Source of truth for multi-tenant pipelines. Copy to users.yaml and edit.
# The admin CLI (npm run admin -- users add/remove/...) manipulates this
# file; the shared layer routes articles based on it; per-user librarian
# and digest iterate over it.
#
# The file is gitignored because it contains user contact info.

# Default cosine threshold used when a user doesn't override. Deliberately
# lenient (0.43, low side of qwen3-embed-8b's discrimination band: matches
# land 0.60-0.70, non-matches 0.30-0.35): vault entry errs inclusive so the
# citation graph can later reveal which admission calls were right. The
# digest — not routing — defends the user's attention; quality junk is
# filtered upstream by the summarize phase's gate.
default_threshold: 0.43

users:
  - handle: velvet                   # lowercase, digits, dashes; starts with a letter
    name: Velvet
    email_to: velvetmoon222999@gmail.com
    vault_remote: git@github.com:Code4me2/vault.git
    vault_branch: main               # optional, default 'main'
    enabled: true                    # optional, default true
    onboarded: 2026-06-28            # informational
    # threshold: 0.55                # optional per-user override
    #
    # One paragraph PER DISTINCT INTEREST AREA. Each is embedded separately
    # and routing matches on the best-scoring one, so unrelated interests
    # don't blur each other. A single string (instead of a list) also works.
    interests:
      - >
        Mechanistic interpretability of large language models — circuits,
        sparse autoencoders, probing what internal representations compute.
      - >
        Agentic systems and tool-using LLM architectures: planners,
        multi-step reasoning, orchestration frameworks.
      - >
        Operational engineering for LLM-based research pipelines on local
        hardware — vllm serving, model quantization, kv-cache tuning,
        deployment patterns.
