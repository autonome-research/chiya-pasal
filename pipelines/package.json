{
  "name": "chiya-pipelines",
  "version": "0.0.1",
  "private": true,
  "description": "Curation pipelines (librarian, digest) for the Chiya Library, built on thread-phase.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "digest:am": "tsx src/digest.ts AM",
    "digest:pm": "tsx src/digest.ts PM",
    "librarian": "tsx src/librarian.ts"
  },
  "dependencies": {
    "thread-phase": "github:Code4me2/thread-phase#9417e4f4cf8a825c868b1b58760a855806826215",
    "better-sqlite3": "^11.5.0",
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
