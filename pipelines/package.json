{
  "name": "chiya-pipelines",
  "version": "0.0.1",
  "private": true,
  "description": "Curation pipelines (librarian, digest) for the Chiya Library, built on thread-phase.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "digest:am": "tsx src/digest.ts AM",
    "digest:pm": "tsx src/digest.ts PM",
    "librarian": "tsx src/librarian.ts",
    "intake": "tsx src/intake.ts",
    "doctor": "tsx src/doctor.ts",
    "status": "tsx src/status.ts",
    "migrate-queue": "tsx scripts/migrate-queue.ts",
    "backfill-source-urls": "tsx scripts/backfill-source-urls.ts",
    "backfill-archive-articles": "tsx scripts/backfill-archive-articles.ts",
    "migrate-topics": "tsx scripts/migrate-topics.ts",
    "api-ingest": "tsx src/collection/api-ingest.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "glob": "^11.0.0",
    "thread-phase": "github:Code4me2/thread-phase#88b16b0e02f06c672c5ebdb3379a31d2ae97cff0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
