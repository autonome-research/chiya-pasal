# Chiya pipelines environment.
#
# Copy to `.env` (gitignored) and fill in. Systemd units load this via
# EnvironmentFile=-%h/chiya-library/pipelines/.env (the leading `-` makes
# it optional, so dev/CI can run without it).
#
# Local dev: `set -a && source .env && set +a` before `npm run digest:am`,
# `npm run librarian`, etc.

# Required for single-tenant mode — daily digest is emailed to this address.
# Multi-tenant mode reads per-user email from config/users.yaml instead.
CHIYA_EMAIL_TO=your-address@example.com

# Contact email sent with Unpaywall open-access lookups (they require one;
# no signup or key). Used by the shared enrich phase to find legal OA copies
# of paywalled DOIs.
CHIYA_UNPAYWALL_EMAIL=your-address@example.com

# Contact address for the arXiv/Crossref polite pools used by demand-ingest
# (the daily citation-demand job). Falls back to CHIYA_UNPAYWALL_EMAIL; with
# neither set the job logs a WARN and uses the anonymous pools.
CHIYA_CONTACT_EMAIL=your-address@example.com

# Where chiya-alert@.service mails unit failures (last 30 journal lines of the
# failed unit). Falls back to CHIYA_EMAIL_TO; with neither set the alerter logs
# to the journal and exits 0 — nothing breaks, you just get no mail.
CHIYA_ALERT_EMAIL=your-address@example.com

# Optional — defaults match the GB10 box. Override per machine.
# VAULT_DIR=/home/you/vault
# VAULT_REMOTE=origin
# VAULT_BRANCH=main

# Optional — multi-tenant layout root (per-user dirs + shared cache).
# CHIYA_DATA_ROOT=/home/you/chiya-data
# CHIYA_USERS_FILE=/home/you/chiya-library/pipelines/config/users.yaml

# Optional — inference targets. Defaults route to tiny-emerson's raw vllm
# (qwen36) via the SSH tunnel (chiya-tunnel-tiny.service, localhost:11435 →
# tiny:9000). NOT tiny:8000 — that's a PI/Hermes wrapper that breaks tool
# calls. Override to point at a different box / model / API key.
# FAST_INFERENCE_BASE_URL=http://localhost:11435/v1
# FAST_INFERENCE_API_KEY=not-needed
# FAST_INFERENCE_MODEL=qwen36
# TOOLS_INFERENCE_BASE_URL=http://localhost:11435/v1
# TOOLS_INFERENCE_API_KEY=not-needed
# TOOLS_INFERENCE_MODEL=qwen36

# Optional — embeddings endpoint for the multi-tenant routing layer.
# Defaults to the qwen3-embed-8b port-forward (spark k8s cluster).
# EMBED_INFERENCE_BASE_URL=http://localhost:11437/v1
# EMBED_INFERENCE_API_KEY=not-needed
# EMBED_INFERENCE_MODEL=qwen3-embed-8b

# Optional — sqlite path used by both ArticleStore and the thread-phase
# JobStore. Defaults to $VAULT_DIR/.chiya-pipelines.db.
# THREAD_PHASE_DB=/path/to/db

# Optional — fast-tier output-token cap for digest classify/draft calls.
# CHIYA_FAST_MAX_TOKENS=4000

# Optional — TypeScript API source reliability knobs.
# CHIYA_SOURCE_TIMEOUT_MS=15000
# CHIYA_SOURCE_RETRIES=1

# Optional — routing mode. 'embedding' (default) cosine-matches summaries
# against user interests via the embed endpoint; 'broadcast' copies every
# quality-passing article to every enabled user (embeddings not used —
# the degraded mode while the embedding service is down).
# CHIYA_ROUTING_MODE=embedding
