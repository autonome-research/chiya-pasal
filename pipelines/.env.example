# Chiya pipelines environment.
#
# Copy to `.env` (gitignored) and fill in. Systemd units load this via
# EnvironmentFile=-%h/chiya-library/pipelines/.env (the leading `-` makes
# it optional, so dev/CI can run without it).
#
# Local dev: `set -a && source .env && set +a` before `./run-cycle.sh AM`,
# `npm run digest:am`, `npm run librarian`, etc.

# Required — daily digest is emailed to this address via gws gmail.
CHIYA_EMAIL_TO=your-address@example.com

# Optional — defaults match the GB10 box. Override per machine.
# VAULT_DIR=/home/you/vault
# VAULT_REMOTE=origin
# VAULT_BRANCH=main

# Optional — inference targets. Defaults route to tiny-emerson Ollama via
# the SSH tunnel (chiya-tunnel-tiny.service). Override to point at a
# different box / model / API key.
# FAST_INFERENCE_BASE_URL=http://localhost:11435/v1
# FAST_INFERENCE_API_KEY=not-needed
# FAST_INFERENCE_MODEL=gemma4:e4b
# TOOLS_INFERENCE_BASE_URL=http://localhost:11435/v1
# TOOLS_INFERENCE_API_KEY=not-needed
# TOOLS_INFERENCE_MODEL=gemma4:26b

# Optional — sqlite path used by both ArticleStore and the thread-phase
# JobStore. Defaults to $VAULT_DIR/.chiya-pipelines.db.
# THREAD_PHASE_DB=/path/to/db

# Optional — TypeScript API source reliability knobs.
# CHIYA_SOURCE_TIMEOUT_MS=15000
# CHIYA_SOURCE_RETRIES=1

# Optional — daily full-cycle behavior.
# If enabled, digest.ts skips email once a successful email-send event already
# exists for the local date. `run-cycle.sh` and chiya-daily.service default this
# to 1; standalone AM/PM digest timers leave it unset so both digest emails can
# still send unless you opt in here.
# CHIYA_DIGEST_ONCE_DAILY=1

# Optional — how much graph-curation work the daily cycle attempts before
# sending the digest. Increase passes/batch for beefier inference setups; lower
# them for laptops or slow remote models.
# CHIYA_CYCLE_LIBRARIAN_PASSES=5
# CHIYA_CYCLE_LIBRARIAN_BATCH=10
# CHIYA_CYCLE_LIBRARIAN_MINUTES=8
