[Unit]
Description=Chiya intake — absorb raw/inbox/*-articles.md into ArticleStore
Documentation=https://github.com/Code4me2/chiya-library
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/chiya-library/pipelines
# Rebuild the better-sqlite3 native binding against the running Node ABI.
# When Node gets upgraded out-of-band (apt unattended-upgrades, manual nvm
# bump) the precompiled .node file is silently incompatible and every service
# using this node_modules crashes at first DB open. Rebuilding before each
# run is ~1s when the binding's already current and the only reliable fix
# when it isn't. See chiya-library/docs/runbook for full incident notes.
ExecStartPre=%h/chiya-library/pipelines/scripts/rebuild-better-sqlite3.sh
ExecStart=/usr/bin/env npx tsx src/intake.ts
Environment=VAULT_DIR=%h/vault
# Intake doesn't read CHIYA_EMAIL_TO, but loading the file keeps the env
# surface consistent across pipeline units. Leading `-` makes it optional.
EnvironmentFile=-%h/chiya-library/pipelines/.env
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600
