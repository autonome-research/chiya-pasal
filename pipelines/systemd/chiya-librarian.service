[Unit]
Description=Chiya librarian — drain pending articles via agentic exploration
Documentation=https://github.com/Code4me2/chiya-library
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/chiya-library/pipelines
# Rebuild the better-sqlite3 native binding against the running Node ABI.
# When Node gets upgraded out-of-band (apt unattended-upgrades, manual nvm
# bump) the precompiled .node file is silently incompatible and every service
# using this node_modules crashes at first DB open. Rebuilding before each
# run is ~1s when the binding's already current and the only reliable fix
# when it isn't.
ExecStartPre=/usr/bin/env npm rebuild better-sqlite3 --silent
# Per-article router → 4 parallel scouts → reviewer → deterministic write.
# Outer batch concurrency=4, per-article wall ~50-85s under load (7 LLM calls
# per article). batch=10 + minutes=8 lands ~4-5 min, comfortably under the
# 10-min timer cadence.
ExecStart=/usr/bin/env npx tsx src/librarian.ts --batch=10 --minutes=8
Environment=VAULT_DIR=%h/vault
# Loads CHIYA_EMAIL_TO and any local overrides; leading `-` keeps the unit
# valid on hosts that haven't set up the file yet.
EnvironmentFile=-%h/chiya-library/pipelines/.env
StandardOutput=journal
StandardError=journal
# Headroom for the 26b tools-tier model used by scouts + reviewer. 8-min
# in-pipeline deadline + slack for 4 in-flight articles to finish their
# remaining LLM calls before the runner exits.
TimeoutStartSec=1200
