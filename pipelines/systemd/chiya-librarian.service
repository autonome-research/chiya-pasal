[Unit]
Description=Chiya librarian — drain pending articles from the queue
Documentation=https://github.com/Code4me2/chiya-library
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/chiya-library/pipelines
# --batch=20 keeps the predictable 4-conc × ~60s/upsert × 80%-keep wall
# time well under --minutes=6. Smaller-than-it-looks-necessary because
# in-flight LLM calls aren't cancellable yet (see thread-phase ROADMAP);
# in-flight articles must finish before the run exits, so the systemd
# timeout needs slack over the deadline for the tail.
ExecStart=/usr/bin/env npx tsx src/librarian.ts --batch=20 --minutes=6
Environment=VAULT_DIR=%h/vault
StandardOutput=journal
StandardError=journal
# Generous timeout: --minutes=6 plus up to ~9 min for the 4 in-flight
# articles to finish their current LLM call after the deadline fires.
TimeoutStartSec=900
