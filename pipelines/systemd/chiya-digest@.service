[Unit]
Description=Chiya digest pipeline (%i)
Documentation=https://github.com/Code4me2/chiya-library
# A failed run emails the operator; without this a broken digest is silent.
OnFailure=chiya-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/chiya-library/pipelines
# Rebuild the better-sqlite3 native binding against the running Node ABI.
# When Node gets upgraded out-of-band the precompiled .node file is silently
# incompatible and every service using this node_modules crashes at first DB
# open. Rebuilding before each run is ~1s when the binding is already current
# and the only reliable fix when it isn't.
ExecStartPre=%h/chiya-library/pipelines/scripts/rebuild-better-sqlite3.sh
ExecStart=/usr/bin/env npx tsx src/digest.ts %i
Environment=VAULT_DIR=%h/vault
# Loads CHIYA_EMAIL_TO and any local overrides; leading `-` keeps the unit
# valid on hosts that haven't set up the file yet.
EnvironmentFile=-%h/chiya-library/pipelines/.env
StandardOutput=journal
StandardError=journal
TimeoutStartSec=900

# Run-only-once-at-a-time per instance is implicit (Type=oneshot + same instance name).
